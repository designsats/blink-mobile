{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "allowJs": false,
    "sourceMap": true,
    "baseUrl": "./",
    "paths": {
      "@app/*": ["app/*"]
    },
    "types": [
      "node",
      "react-native",
      "@wdio/globals/types",
      "@wdio/mocha-framework",
      "@wdio/devtools-service",
      "@types/jest"
    ]
  },
  "include": ["app", "e2e", "__tests__"],
  // Code Connect templates use the virtual "figma" module whose global types
  // break jest's require.resolve — they are typechecked by tsconfig.figma.json
  // and validated by `figma connect parse` instead.
  "exclude": ["**/*.figma.ts"]
}
